{
  "$schema": "https://www.ohmygame.ai/schema/plugin-2.json",
  "id": "ohmygame/pixellab",
  "version": "1.3.2",
  "engines": { "ohmygame-api": "^2.7.0" },
  "displayName": "%displayName%",
  "description": "%description%",
  "longDescription": "%longDescription%",
  "examples": ["%example.1%", "%example.2%"],
  "icon": "./assets/icon.svg",
  "categories": ["art"],
  "capabilities": { "network": ["api.pixellab.ai"] },
  "configuration": {
    "apiKey": {
      "type": "secret",
      "title": "%config.apiKey%",
      "description": "%config.apiKey.description%",
      "required": true
    }
  },
  "contributes": {
    "providers": [{
      "id": "pixellab",
      "title": "%displayName%",
      "icon": "./assets/icon.svg",
      "apiKey": "apiKey",
      "media": {
        "adapter": "./media.js",
        "auth": { "header": "authorization", "scheme": "Bearer" },
        "image": { "models": [
          { "id": "pixen", "title": "%nodes.pixen.title%", "resolutions": ["512"], "aspectRatios": ["1:1"], "maxReferenceImages": 0 },
          { "id": "create-character", "title": "%nodes.createCharacter.title%", "resolutions": ["512"], "aspectRatios": ["1:1"], "maxReferenceImages": 1, "maxReferenceImageDimension": 256 },
          { "id": "skeleton-animation", "title": "%nodes.skeletonAnimation.title%", "resolutions": ["512"], "aspectRatios": ["1:1"], "minReferenceImages": 1, "maxReferenceImages": 1, "maxReferenceImageDimension": 256 }
        ] }
      }
    }],
    "settings": { "groups": [{ "rows": [{ "field": "apiKey" }] }] },
    "skills": "./skills/"
  }
}
