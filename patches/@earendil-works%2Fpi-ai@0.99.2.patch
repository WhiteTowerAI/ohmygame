+import type { AssistantMessageDiagnostic } from "./diagnostics.js";
+export declare function sanitizeDiagnosticUrl(value: unknown): string | undefined;
+export declare function sanitizeDiagnosticText(value: unknown, limit?: number): string | undefined;
+export declare function createProviderFailureDiagnostic(error: unknown, endpoint?: string, response?: { status: number; headers: Headers }): AssistantMessageDiagnostic;
