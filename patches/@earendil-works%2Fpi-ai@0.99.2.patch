diff --git a/node_modules/@earendil-works/pi-ai/dist/utils/provider-failure.js b/dist/utils/provider-failure.js
new file mode 100644
index 0000000000000000000000000000000000000000..e2c7d4f02f897d88d00f6146c67a1fb5556cf6df
--- /dev/null
+++ b/dist/utils/provider-failure.js
@@ -0,0 +1,72 @@
+// OhMyGame compatibility patch: preserve provider failure diagnostics without
+// changing errorMessage, which Pi uses for retry and recovery decisions.
+export function sanitizeDiagnosticUrl(value) {
+    if (typeof value !== "string") return undefined;
+    try {
+        const url = new URL(value);
+        if (!/^https?:$/.test(url.protocol)) return undefined;
+        url.username = ""; url.password = ""; url.search = ""; url.hash = "";
+        return url.toString().slice(0, 2000);
+    } catch { return undefined; }
+}
+export function sanitizeDiagnosticText(value, limit = 1000) {
+    if (typeof value !== "string" && typeof value !== "number") return undefined;
+    return String(value).slice(0, Math.max(4000, limit * 4))
+        .replace(/https?:\/\/[^\s<>"']+/gi, (text) => sanitizeDiagnosticUrl(text) ?? "[redacted URL]")
+        .replace(/\b(?:sk|pk)-(?:[a-z0-9_-]{8,})\b/gi, "[redacted]")
+        .replace(/\b(Bearer|Basic)\s+[a-z0-9._~+/=-]+/gi, "$1 [redacted]")
+        .replace(/((?:api[-_ ]?key|access[-_ ]?token|refresh[-_ ]?token|authorization|password|secret|cookie)["']?\s*[:=]\s*["']?)[^\s,;"'}]+/gi, "$1[redacted]")
+        .slice(0, limit);
+}
+function field(object, key) {
+    try { return object && typeof object === "object" ? object[key] : undefined; }
+    catch { return undefined; }
+}
+function errorInfo(error) {
+    const info = {};
+    const name = sanitizeDiagnosticText(field(error, "name"), 100);
+    const message = sanitizeDiagnosticText(field(error, "message") ?? (typeof error === "string" ? error : undefined));
+    const code = sanitizeDiagnosticText(field(error, "code"), 100);
+    if (name) info.name = name;
+    if (message) info.message = message;
+    if (code) info.code = code;
+    return info;
+}
+export function createProviderFailureDiagnostic(error, endpoint, response) {
+    const details = {};
+    const status = field(error, "status") ?? field(error, "statusCode") ?? field(field(error, "$metadata"), "httpStatusCode") ?? field(response, "status");
+    if (typeof status === "number" && Number.isInteger(status) && status >= 100 && status <= 599) details.status = status;
+    const body = field(error, "error");
+    const errorCode = sanitizeDiagnosticText(field(body, "code") ?? field(body, "type") ?? field(error, "code"), 100);
+    if (errorCode) details.errorCode = errorCode;
+    const headers = field(error, "headers") ?? field(response, "headers");
+    let headerRequestId;
+    try { headerRequestId = headers?.get?.("x-request-id") ?? headers?.get?.("request-id"); } catch { /* SDK headers are optional. */ }
+    const requestId = sanitizeDiagnosticText(field(error, "request_id") ?? field(field(error, "$metadata"), "requestId") ?? headerRequestId, 200);
+    if (requestId) details.requestId = requestId;
+    const safeEndpoint = sanitizeDiagnosticUrl(endpoint);
+    if (safeEndpoint) details.endpoint = safeEndpoint;
+    const causes = [];
+    const seen = new Set();
+    const visit = (value, depth) => {
+        if (depth > 6 || seen.size >= 24 || causes.length >= 12 || value == null || seen.has(value)) return;
+        seen.add(value);
+        const info = errorInfo(value);
+        if (value !== error && Object.keys(info).length) causes.push(info);
+        visit(field(value, "cause"), depth + 1);
+        const errors = field(value, "errors");
+        if (Array.isArray(errors)) for (const nested of errors.slice(0, 12)) visit(nested, depth + 1);
+    };
+    visit(error, 0);
+    if (causes.length) details.causes = causes;
+    const info = errorInfo(error);
+    return {
+        type: "provider_failure",
+        timestamp: Date.now(),
+        error: { ...info, message: info.message ?? "The model request failed" },
+        details,
+    };
+}
+export function appendProviderFailureDiagnostic(output, error, endpoint, response) {
+    output.diagnostics = [...(output.diagnostics ?? []), createProviderFailureDiagnostic(error, endpoint, response)];
+}
