diff --git a/restricted-origins.ts b/restricted-origins.ts
new file mode 100644
index 0000000000000000000000000000000000000000..79a6d8c1ed223f5d5f91f5dc950949a023809fb4
--- /dev/null
+++ b/restricted-origins.ts
@@ -0,0 +1,50 @@
+// A host that embeds the adapter can restrict an HTTP server to exact origins
+// with `allowedOrigins`. Such a server's requests never leave those origins:
+// its URL and headers are used as written (no environment expansion or
+// command secrets), redirects are refused rather than followed, and nothing
+// else (OAuth discovery, header commands, failure probes) reaches the network
+// on its behalf.
+import type { ServerEntry } from "./types.ts";
+
+/** The server's allowed origins, or undefined when it has no restriction. */
+export function restrictedOrigins(definition: Pick<ServerEntry, "allowedOrigins">): string[] | undefined {
+  const origins = definition.allowedOrigins;
+  if (origins === undefined) return undefined;
+  // A restriction that can't be read restricts everything rather than nothing.
+  if (!Array.isArray(origins) || origins.length === 0) throw new Error("allowedOrigins must list at least one origin");
+  for (const origin of origins) {
+    let parsed: URL;
+    try {
+      parsed = new URL(origin);
+    } catch {
+      throw new Error(`allowedOrigins has an invalid origin: ${String(origin)}`);
+    }
+    if (typeof origin !== "string" || parsed.origin !== origin || !/^https?:$/.test(parsed.protocol))
+      throw new Error(`allowedOrigins has an invalid origin: ${String(origin)}`);
+  }
+  return origins;
+}
+
+/** Why a restricted server's definition asks for something its restriction rules out, or undefined. */
+export function restrictionConflict(definition: ServerEntry): string | undefined {
+  if (definition.requestHeadersCommand !== undefined) return "requestHeadersCommand";
+  if (definition.auth !== undefined && definition.auth !== false) return "auth";
+  if (definition.oauth !== undefined && definition.oauth !== false) return "oauth";
+  if (definition.bearerToken !== undefined || definition.bearerTokenEnv !== undefined || definition.bearerTokenStore !== undefined) return "bearer tokens";
+  return undefined;
+}
+
+/** A fetch that only reaches the given origins and refuses redirects. */
+export function createOriginGuardedFetch(origins: readonly string[], base: typeof fetch = fetch): typeof fetch {
+  const allowed = new Set(origins);
+  return (async (input: string | URL | Request, init?: RequestInit) => {
+    const url = new URL(input instanceof Request ? input.url : String(input));
+    if (!allowed.has(url.origin)) throw new Error(`MCP request to ${url.origin} is outside this server's allowed origins`);
+    const response = await base(input, { ...init, redirect: "manual" });
+    if (response.type === "opaqueredirect" || (response.status >= 300 && response.status < 400)) {
+      await response.body?.cancel().catch(() => {});
+      throw new Error(`MCP server at ${url.origin} answered with a redirect (${response.status}), which this server doesn't follow`);
+    }
+    return response;
+  }) as typeof fetch;
+}
