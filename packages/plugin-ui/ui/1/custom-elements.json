        {
          "kind": "class",
          "name": "OmgCommandButton",
          "tagName": "omg-command-button",
          "customElement": true,
          "description": "`<omg-command-button command input variant concurrent quiet>`: runs one of the plugin's commands, by its manifest id, when clicked. `input` is JSON, or set the `input` property. While it runs, the button is busy and shows the command's progress beside it, and other command buttons wait unless they are `concurrent`. A failure shows beside it unless it is `quiet`, and is its `error` attribute until the next run, so a page that draws the button again can pass it on. Events: `omg-command-start` (cancelable, before it runs), `omg-command-result` with `detail.result`, and `omg-command-error` with `detail.error`, cancelable to show the failure yourself.",
          "superclass": {
            "name": "OmgButton",
            "module": "ui/1/controls.js"
          },
          "attributes": [
            {
              "name": "busy",
              "description": "Shows a spinner and takes no clicks.",
              "type": {
                "text": "boolean"
              },
              "inheritedFrom": {
                "name": "OmgButton",
                "module": "ui/1/controls.js"
              }
            },
            {
              "name": "command",
              "description": "The command's id in the manifest.",
              "type": {
                "text": "string"
              }
            },
            {
              "name": "concurrent",
              "description": "Runs while other command buttons run, and doesn't make them wait.",
              "type": {
                "text": "boolean"
              }
            },
            {
              "name": "disabled",
              "description": "Takes no clicks.",
              "type": {
                "text": "boolean"
              },
              "inheritedFrom": {
                "name": "OmgButton",
                "module": "ui/1/controls.js"
              }
            },
            {
              "name": "error",
              "description": "The last run's failure, until the next run.",
              "type": {
                "text": "string"
              }
            },
            {
              "name": "input",
              "description": "The command's input, as JSON.",
              "type": {
                "text": "string"
              }
            },
            {
              "name": "quiet",
              "description": "Doesn't show a failure beside it.",
              "type": {
                "text": "boolean"
              }
            },
            {
              "name": "variant",
              "description": "Secondary by default.",
              "type": {
                "text": "\"secondary\" | \"primary\" | \"ghost\" | \"danger\""
              },
              "inheritedFrom": {
                "name": "OmgButton",
                "module": "ui/1/controls.js"
              }
            }
