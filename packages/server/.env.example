# OhMyGame's game service (packages/games/src/server.ts): rooms, cloud saves and leaderboards.
# `bun run start:multiplayer` and `bun run dev:multiplayer` read this file when it exists.
# On Railway, set the same variables in the service's Variables instead. See docs/multiplayer.md.

# Signs guest tokens: at least 32 random bytes (openssl rand -hex 32). Changing it ends every guest.
MULTIPLAYER_GUEST_SECRET=d527e491bc748f9aa569ca353ae6333bf465381bb4090977caa8ceb5280484bd
# Rooms and registered deployments. On Railway, a path on the persistent volume.
MULTIPLAYER_DATABASE_PATH=/data/multiplayer.sqlite
# This service's domain, without https://.
MULTIPLAYER_PUBLIC_ADDRESS=games.ohmygame.ai
# The header the ingress overwrites with the client's address (x-real-ip on Railway).
# Set this or MULTIPLAYER_TRUST_PROXY_HOPS, not both; leave both empty without a proxy.
MULTIPLAYER_CLIENT_IP_HEADER=x-real-ip
# MULTIPLAYER_TRUST_PROXY_HOPS=1

# This service's HTTPS origin: publishers register their games' deployments with it.
# OhMyGame publishing uses https://games.ohmygame.ai unless OHMYGAME_GAME_SERVICE_URL says otherwise.
GAME_SERVICE_PUBLIC_URL=https://games.ohmygame.ai
# The account service that signs game tokens; exactly the cloud's GAME_SIGN_IN_ISSUER.
OHMYGAME_ACCOUNT_ISSUER=https://cloud.ohmygame.ai
# The cloud API: which games are published, and who owns them.
OHMYGAME_CLOUD_API_URL=https://cloud.ohmygame.ai

# Postgres for cloud saves and leaderboards. On Railway: ${{Postgres.DATABASE_URL}}.
GAME_DATA_DATABASE_URL=${{Postgres.DATABASE_URL}}
# Enables the operator route that deletes an account's data (openssl rand -hex 32).
GAME_DATA_ADMIN_TOKEN=cd80d85f1874ab86f13e4fea0c9e2290d5065a59a256936fbc825bf6f48aa5d6

# Optional.
# PORT=43130
# MULTIPLAYER_HOST=0.0.0.0
# MULTIPLAYER_MAX_ROOMS=100
# MULTIPLAYER_DEPLOYMENTS_FILE=/data/deployments.json
