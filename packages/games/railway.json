{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bun run build:multiplayer",
    "watchPatterns": [
      "/packages/games/**",
      "/packages/server/**",
      "/packages/sdk/**",
      "/package.json",
      "/bun.lock"
    ]
  },
  "deploy": {
    "startCommand": "bun run start:multiplayer",
    "healthcheckPath": "/healthz",
    "restartPolicyType": "ON_FAILURE"
  }
}
