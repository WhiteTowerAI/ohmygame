{
  "name": "@ohmygame/games",
  "version": "0.0.0",
  "description": "OhMyGame's built-in multiplayer rules and the hosted service that registers them.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "ohmygame-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./gomoku": {
      "ohmygame-source": "./src/gomoku-board.ts",
      "types": "./dist/gomoku-board.d.ts",
      "default": "./dist/gomoku-board.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ohmygame/sdk": "workspace:*",
    "@ohmygame/server": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "^5.9.2"
  }
}
