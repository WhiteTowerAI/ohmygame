{
  "buildCommand": "npm run build:community",
  "outputDirectory": "dist/community-web",
  "rewrites": [
    { "source": "/account-api/:path*", "destination": "https://portal.open-game.ai/api/:path*" },
    { "source": "/v1/:path*", "destination": "https://publish.open-game.ai/v1/:path*" },
    { "source": "/games/:path*", "destination": "/index.html" },
    { "source": "/pricing", "destination": "/index.html" },
    { "source": "/account/:path*", "destination": "/index.html" },
    { "source": "/plans", "destination": "/index.html" },
    { "source": "/usage", "destination": "/index.html" },
    { "source": "/billing", "destination": "/index.html" }
  ]
}
