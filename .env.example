# Product authentication (public browser values)
# Optional for local development. See CONTRIBUTING.md for integration setup.
# If either value is absent, bun run dev / dev:desktop enables local debug sign-in and publishing.
# Production builds never enable this fallback.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# PostHog product analytics (public browser values)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Sentry error monitoring (public client DSN)
SENTRY_DSN=

# Optional local/preview Cloud API for real account and publishing integration.
# Local debug sign-in and publishing do not require this service.
CLOUD_API_URL=http://127.0.0.1:43130

# Desktop packaging (public, read-only update feed)
DESKTOP_UPDATE_URL=https://updates.ohmygame.ai/desktop
