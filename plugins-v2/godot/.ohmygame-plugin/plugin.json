{
  "$schema": "https://ohmygame.dev/schema/plugin-2.json",
  "id": "ohmygame/godot",
  "version": "1.0.0",
  "engines": { "ohmygame-api": "^2.0.0" },
  "displayName": "%displayName%",
  "description": "%description%",
  "icon": "./assets/icon.svg",
  "categories": ["engine"],
  "entrypoints": { "native": "./native/index.mjs" },
  "capabilities": {
    "native": true,
    "project.files": "write",
    "processes": ["godot"]
  },
  "configuration": {
    "godotPath": {
      "type": "path",
      "title": "%config.godotPath%",
      "description": "%config.godotPath.description%"
    }
  },
  "contributes": {
    "projectTypes": [
      {
        "id": "godot-game",
        "title": "%type.title%",
        "description": "%type.description%",
        "icon": "./assets/icon.svg",
        "template": "./templates/godot-game/",
        "recognize": { "files": ["project.godot"] },
        "preview": "web-build",
        "playtest": "web"
      }
    ],
    "skills": "./skills/",
    "tools": [
      {
        "name": "godot_status",
        "description": "Report the Godot executable this project uses, its version, and whether Godot's web export templates are installed for it.",
        "input": "./tools/empty.json",
        "output": "./tools/status-output.json"
      },
      {
        "name": "run_headless",
        "description": "Run the project's main scene, or another scene, without a window for a number of frames, and return Godot's output and the errors it printed. Use it to check scripts and scenes after editing them.",
        "input": "./tools/run-headless.json",
        "output": "./tools/run-output.json"
      },
      {
        "name": "export_web",
        "description": "Export the project as a web build into .ohmygame/build/web, the build the game panel plays. Returns Godot's output.",
        "input": "./tools/empty.json",
        "output": "./tools/run-output.json"
      }
    ],
    "commands": [
      {
        "id": "run-in-godot",
        "title": "%command.run%",
        "run": { "native": "runInGodot" },
        "slots": [{ "slot": "project.toolbar", "when": "project.plugin('ohmygame/godot')" }]
      }
    ],
    "settings": {
      "groups": [{ "rows": [{ "field": "godotPath" }, { "widget": "status" }] }]
    }
  }
}
