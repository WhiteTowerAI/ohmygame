{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.ohmygame.ai/schema/project-1.json",
  "title": "OhMyGame project file (ohmygame.json)",
  "type": "object",
  "required": [
    "type"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "pattern": "^(?:general|interactive-story|[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*)$",
      "description": "A core type, or publisher/name:type from a plugin"
    },
    "plugins": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 5,
              "maxLength": 256
            },
            {
              "type": "boolean"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
